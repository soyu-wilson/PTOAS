// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %s -o - | FileCheck %s
// RUN: sed 's/\["native_store"\]/[]/' %s > %t.empty.pto
// RUN: ptoas --pto-arch=a5 --pto-backend=vpto --emit-vpto-llvm-ir %t.empty.pto -o - | FileCheck %s --check-prefix=EMPTY

// Native calls keep their memref descriptor ABI through the split VPTO emitter.
// The symbol list must also survive LLVM export for selective object linking.
module attributes {
  pto.target_arch = "a5",
  pto.kernel_kind = #pto.kernel_kind<vector>,
  pto.preserve_external_call_memrefs,
  pto.native_template_fallback_symbols = ["native_store"]
} {
  func.func @native_abi(%dst: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %mem = builtin.unrealized_conversion_cast %dst : !pto.ptr<f32, gm> to memref<4xf32, #pto.address_space<gm>>
    func.call @native_store(%mem) : (memref<4xf32, #pto.address_space<gm>>) -> ()
    return
  }
  func.func private @native_store(memref<4xf32, #pto.address_space<gm>>) attributes {llvm.emit_c_interface}
}

// CHECK: define void @native_abi_mix_aiv(ptr addrspace(1)
// CHECK: call void @_mlir_ciface_native_store(ptr
// CHECK: !pto.native_template_fallback_symbols = !{![[SYMBOL:[0-9]+]]}
// CHECK: ![[SYMBOL]] = !{!"native_store"}
// EMPTY: !pto.native_template_fallback_symbols = !{}
